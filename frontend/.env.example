# --- Cursor online / forwarded preview (recommended) ---
# Leave NEXT_PUBLIC_API_URL unset. The frontend calls the same-origin "/backend"
# path, which Next.js proxies to the backend server-side. Only port 3000 needs
# to be forwarded to your browser.
#
# BACKEND_INTERNAL_URL is the server-side proxy target (defaults to localhost:8000):
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# --- Local / direct setup (optional) ---
# If you forward BOTH ports and want the browser to call the backend directly,
# set one of these to the absolute backend URL instead:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
